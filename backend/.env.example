# Copia este archivo como .env y completa los valores.
FLASK_SECRET_KEY=
FLASK_DEBUG=true
FRONTEND_URL=http://localhost:3000/

# Google Cloud Console > OAuth 2.0 Client ID (tipo Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Arranca en SQLite local. Para MySQL, usa la URL comentada como referencia:
DATABASE_URL=sqlite:///agrocordoba.db
# DATABASE_URL=mysql+pymysql://usuario:contrasena@localhost:3306/agrocordoba?charset=utf8mb4

# false en desarrollo local con HTTP; true en producción con HTTPS
COOKIE_SECURE=false

# Correo SMTP para códigos de verificación de cambios de cuenta.
# Usa una contraseña de aplicación del proveedor, nunca tu contraseña normal.
# En Render Free, prefiere Resend por HTTPS; SMTP puede estar bloqueado por el proveedor.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
