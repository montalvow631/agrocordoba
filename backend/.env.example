# Copia este archivo como .env y completa solo las variables necesarias.
# No agregues contrasenas, tokens ni claves reales a este archivo.

# Requerida para iniciar Flask.
FLASK_SECRET_KEY=

# Configuracion local opcional. Si se omiten, la aplicacion usa sus valores
# predeterminados para desarrollo (SQLite local, HTTP y frontend en localhost).
FLASK_DEBUG=
FRONTEND_URL=
DATABASE_URL=
COOKIE_SECURE=

# Opcionales: Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Opcionales: correo mediante Resend o SMTP.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=
SMTP_USE_SSL=

# Opcionales: crear un administrador al iniciar. Configura ambas juntas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: ruta de los archivos compilados del frontend en despliegues.
FRONTEND_DIST_DIR=
